# LifeLink Pakistan Backend — Environment Variables
# Copy this file to .env and fill in your values.

# ── App ────────────────────────────────────────────────────────────────────────
# Set to "production" for live deployment. This enables:
#   - SECRET_KEY validation (must be changed from default)
#   - SQLite usage warnings
#   - Swagger docs hidden
#   - Error details stripped from API responses
ENVIRONMENT=development

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (development only):
DATABASE_URL=sqlite:///./lifelink.db
# PostgreSQL (production — recommended):
# DATABASE_URL=postgresql://user:password@host:5432/lifelink

# ── Auth / JWT ─────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_a8f5f167f44f4964e6c998dee827110c
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# CORS_ORIGINS=https://lifelinkpakistan.com,https://www.lifelinkpakistan.com

# ── Seeding ────────────────────────────────────────────────────────────────────
# Set to true ONLY for local development to create demo accounts.
# NEVER enable in production — creates accounts with known passwords.
SEED_ON_STARTUP=true

# ── AI / Gemini ────────────────────────────────────────────────────────────────
# Your Google Gemini API key (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Max characters accepted for AI parsing input (default: 2000)
# AI_MAX_INPUT_LENGTH=2000

# ── Rate Limiting ──────────────────────────────────────────────────────────────
# Rate limit for AI endpoint (default: 10/minute)
# RATE_LIMIT=10/minute
