# Production environment variables for LifeLink Pakistan API
# Copy this file to .env and adjust values for your production environment

# ── Application ────────────────────────────────────────────────────────────
APP_NAME=LifeLink Pakistan API
ENVIRONMENT=production

# ── Database ───────────────────────────────────────────────────────────────
# IMPORTANT: Change from SQLite to PostgreSQL for production
# Example: postgresql://user:password@localhost:5432/lifelink
DATABASE_URL=postgresql://user:password@db-host:5432/lifelink_prod

# ── Authentication ────────────────────────────────────────────────────────
# CRITICAL: Generate a new secure secret key with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_VALUE_32_CHARS_MIN

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS (Frontend Origins) ────────────────────────────────────────────────
# Comma-separated list of allowed origins
# CORS_ORIGINS=https://lifelinkpakistan.com,https://www.lifelinkpakistan.com,https://app.lifelinkpakistan.com

# ── Seeding ────────────────────────────────────────────────────────────────
# MUST be false in production - prevents demo accounts
SEED_ON_STARTUP=false

# ── AI / Gemini ────────────────────────────────────────────────────────────
# Add your Gemini API key here
GEMINI_API_KEY=your-gemini-api-key-here

AI_MAX_INPUT_LENGTH=2000

# ── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT=10/minute

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Web Server (Gunicorn) ──────────────────────────────────────────────────
PORT=8000
WEB_CONCURRENCY=4

# ── Security ───────────────────────────────────────────────────────────────
# Set to true to require HTTPS only
HTTPS_ONLY=true
